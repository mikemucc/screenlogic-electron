{
  "name": "screenlogic-electron",
  "version": "1.0.0",
  "description": "An attempt to build an electron based frontend for the screenlogic",
  "homepage": "https://github.com/mikemucc/screenlogic-electron#readme",
  "bugs": {
    "url": "https://github.com/mikemucc/screenlogic-electron/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikemucc/screenlogic-electron.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "jest --runInBand && node -e \"require('child_process').execSync('node --check renderer.js && node --check main.js && node --check preload.js && node --check scripts/generate-preload.js', {stdio:'inherit'})\"",
    "generate-preload": "node scripts/generate-preload.js",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux"
  },
  "dependencies": {
    "node-screenlogic": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.5.1"
  },
  "build": {
    "appId": "com.screenlogic.electron",
    "productName": "ScreenLogic",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true
  }
}
