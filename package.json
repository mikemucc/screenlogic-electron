{
  "name": "screenlogic-electron",
  "version": "1.0.0",
  "description": "An attempt to build an electron based frontend for the screenlogic",
  "homepage": "https://github.com/mikemucc/screenlogic-electron#readme",
  "bugs": {
    "url": "https://github.com/mikemucc/screenlogic-electron/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikemucc/screenlogic-electron.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "test": "jest --runInBand",
    "package": "electron-builder",
    "generate-preload": "node scripts/generate-preload.js"
  },
  "dependencies": {
    "node-screenlogic": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.0.0",
    "jest": "^29.0.0"
  },
  "build": {
    "appId": "com.screenlogic.electron",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "build"
    }
  }
}
